              },
              "many" : {
                "stringUnit" : { "state" : "translated", "value" : "تعذّر على Shrinker Pro البدء، ولذلك لا يمكنه ضغط %lld ملفًا فتحتها. أنهِ التطبيق وأعد تشغيله للمحاولة مرة أخرى." }

    "Your originals will be overwritten and cannot be recovered. Converted files keep a separate extension, so those originals are left alone." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Your originals will be overwritten and cannot be recovered. Converted files keep a separate extension, so those originals are left alone." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "ستتم الكتابة فوق ملفاتك الأصلية ولن يمكن استرجاعها. أما الملفات المحوَّلة فتحتفظ بامتداد مختلف، ولذلك تبقى ملفاتها الأصلية كما هي." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Els teus originals es sobreescriuran i no es podran recuperar. Els arxius convertits mantenen una extensió diferent, així que aquells originals no es toquen." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Vaše originály budou přepsány a nepůjde je obnovit. Převedené soubory mají vlastní příponu, takže těch originálů se to netýká." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Dine originaler bliver overskrevet og kan ikke gendannes. Konverterede arkiver beholder deres egen endelse, så de originaler bliver ikke rørt." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Deine Originale werden überschrieben und können nicht wiederhergestellt werden. Konvertierte Dateien behalten eine eigene Dateiendung — diese Originale bleiben also unangetastet." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Τα πρωτότυπά σας θα αντικατασταθούν και δεν θα είναι δυνατή η ανάκτησή τους. Τα αρχεία που μετατρέπονται διατηρούν διαφορετική επέκταση, οπότε εκείνα τα πρωτότυπα δεν θίγονται." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Tus originales se sobrescribirán y no se podrán recuperar. Los archivos convertidos conservan una extensión distinta, así que esos originales no se tocan." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "فایل‌های اصلی شما بازنویسی می‌شوند و دیگر قابل بازیابی نخواهند بود. فایل‌های تبدیل‌شده پسوند جداگانه‌ای دارند، بنابراین فایل‌های اصلی آن‌ها دست‌نخورده می‌مانند." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Alkuperäistiedostosi ylikirjoitetaan, eikä niitä voi palauttaa. Muunnetut tiedostot saavat oman tiedostopäätteensä, joten niiden alkuperäistiedostot jäävät koskematta." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Vos originaux seront écrasés et ne pourront pas être récupérés. Les fichiers convertis gardent une extension différente : ces originaux-là ne sont donc pas touchés." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "קבצי המקור שלך ישוכתבו ולא ניתן יהיה לשחזר אותם. קבצים שהומרו מקבלים סיומת נפרדת, ולכן קבצי המקור שלהם נשארים כמו שהם." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Vaši originali bit će presnimljeni i neće se moći vratiti. Konvertirane datoteke imaju drugu ekstenziju, pa ti originali ostaju nedirnuti." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Az eredeti fájljai felülíródnak, és nem állíthatók vissza. Az átalakított fájlok külön kiterjesztést kapnak, így azok eredetijét nem érinti a művelet." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Frumritin þín verða yfirskrifuð og ekki er hægt að endurheimta þau. Umbreyttar skrár halda sérstakri skráarendingu, svo að þau frumrit eru látin í friði." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "I tuoi originali verranno sovrascritti e non saranno recuperabili. I file convertiti mantengono un’estensione diversa, quindi quegli originali restano intatti." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "オリジナルは上書きされ、復元できなくなります。変換したファイルは拡張子が別になるため、そのオリジナルはそのまま残ります。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "원본이 덮어쓰기되어 복구할 수 없습니다. 변환된 파일은 확장자가 달라지므로, 해당 원본은 그대로 유지됩니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Originalene dine blir overskrevet og kan ikke gjenopprettes. Konverterte filer beholder sin egen filendelse, så de originalene blir ikke rørt." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Je originelen worden overschreven en kunnen niet worden teruggehaald. Geconverteerde bestanden houden een eigen extensie, dus die originelen blijven ongemoeid." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Originalane dine blir overskrivne og kan ikkje hentast attende. Konverterte filer får eit eige filetternamn, så dei originalane blir ikkje rørte." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Twoje oryginały zostaną nadpisane i nie będzie można ich odzyskać. Pliki po konwersji mają inne rozszerzenie, więc tamte oryginały pozostają nietknięte." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Os seus originais serão sobrescritos e não poderão ser recuperados. Arquivos convertidos mantêm uma extensão diferente, então esses originais ficam intactos." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Os seus originais serão substituídos definitivamente e não é possível recuperá-los. Os ficheiros convertidos mantêm uma extensão diferente, pelo que esses originais ficam intactos." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Originalele dvs. vor fi suprascrise și nu vor putea fi recuperate. Fișierele convertite păstrează o extensie separată, așa că acele originale rămân neatinse." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Ваши оригиналы будут перезаписаны, и восстановить их не удастся. У конвертированных файлов другое расширение, поэтому их оригиналы остаются нетронутыми." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Vaše originály budú prepísané a nedajú sa obnoviť. Konvertované súbory majú vlastnú koncovku, takže tie originály zostanú nedotknuté." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Vaši izvirniki bodo prepisani in jih ne bo mogoče obnoviti. Pretvorjene datoteke obdržijo svojo pripono, zato tisti izvirniki ostanejo nedotaknjeni." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Dina original skrivs över och kan inte återskapas. Konverterade filer behåller ett eget filtillägg, så de originalen lämnas orörda." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "ต้นฉบับของคุณจะถูกเขียนทับและกู้คืนไม่ได้ ไฟล์ที่แปลงแล้วจะใช้นามสกุลต่างออกไป ต้นฉบับเหล่านั้นจึงไม่ถูกแตะต้อง" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Orijinallerinizin üzerine yazılacak ve geri alınamayacaklar. Dönüştürülen dosyalar ayrı bir uzantı taşır, bu yüzden o orijinallere dokunulmaz." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Ваші оригінали буде перезаписано, і відновити їх не вдасться. Конвертовані файли мають інше розширення, тож ті оригінали лишаються недоторканими." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Bản gốc của bạn sẽ bị ghi đè và không thể khôi phục. Tệp đã chuyển đổi giữ phần mở rộng riêng, nên những bản gốc đó được giữ nguyên." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "你的原始檔將會被覆寫，而且無法復原。轉換後的檔案會使用不同的副檔名，所以那些原始檔不受影響。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "你的原始文件将被覆盖，且无法恢复。转换后的文件会使用不同的扩展名，因此那些原始文件不受影响。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "你的原始檔案將被覆寫，且無法復原。轉換後的檔案會使用不同的副檔名，因此那些原始檔案不受影響。" }
        }
      }
    },
    "%@ failed with exit code %d" : {

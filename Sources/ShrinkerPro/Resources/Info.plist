<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Shrinker Pro</string>
    <key>CFBundleDisplayName</key><string>Shrinker Pro</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <!-- The bold line at the foot of the About panel. It is a copyright
         notice, not a second place to repeat the credits above it —
         which is what it used to be, printing "Made by Joshua Omilian.
         Based on Image Shrinker..." directly beneath the same words. -->
    <key>NSHumanReadableCopyright</key><string>© 2026 Joshua Omilian. Shrinker Pro is MIT licensed; bundled tools are not — see THIRD-PARTY-LICENSES.</string>
    <!-- Sparkle: where AppUpdater checks for new releases, and the public
         half of the EdDSA key pair whose private half lives only in the
         signing machine's Keychain (see scripts/release.sh's "sign_update"
         step). appcast.xml is written to the repo root by release.sh and
         served at this exact URL by GitHub Pages. -->
    <key>SUFeedURL</key><string>https://jeso87.github.io/ShrinkerPro/appcast.xml</string>
    <key>SUPublicEDKey</key><string>WJdCmygGtLYY1evpoPN3z8zQIJg3FZ3b108A27ynfd8=</string>
    <!-- Shrinker Pro always checks for updates, once a day. There is no
         longer a Settings toggle for it: this is an open-source app whose
         releases add things users want, and an update nobody hears about
         helps nobody. Being true here also means Sparkle never shows its
         own first-run "should this app check for updates automatically?"
         permission prompt.

         AppUpdater.swift sets both of these on SPUUpdater at launch, so
         these two keys are the bootstrap and that code is the ongoing
         source of truth — the same split this file already used when a
         toggle drove them. Both halves are pinned by
         UpdateSchedulingTests.

         Note what is deliberately absent: SUAutomaticallyUpdate. Checking
         is automatic; installing is not, and never happens without the
         user agreeing to it in Sparkle's dialog. -->
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUScheduledCheckInterval</key><integer>86400</integer>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>Image</string>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.svg-image</string>
                <string>public.png</string>
                <string>com.compuserve.gif</string>
                <string>public.jpeg</string>
                <string>public.webp</string>
                <string>public.avif</string>
                <string>public.heic</string>
                <string>public.heif</string>
            </array>
        </dict>
    </array>
</dict>
</plist>

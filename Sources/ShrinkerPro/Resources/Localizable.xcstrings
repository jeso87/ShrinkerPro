    "Shrinker Pro failed to start, so it can't compress the %lld files you opened. Quit and relaunch to try again." : {
      "comment" : "Body of the alert shown when files are opened but the app failed to start. The one-file form reads 'the file' with no number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "Shrinker Pro failed to start, so it can't compress the file you opened. Quit and relaunch to try again." }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "Shrinker Pro failed to start, so it can't compress the %lld files you opened. Quit and relaunch to try again." }

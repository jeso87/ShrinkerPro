    "Notifications are turned off for Shrinker Pro in System Settings, so none will appear." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Notifications are turned off for Shrinker Pro in System Settings, so none will appear." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "الإشعارات مُعطَّلة لـ Shrinker Pro في إعدادات النظام، لذا لن يظهر أي إشعار." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Les notificacions de Shrinker Pro estan desactivades a la Configuració del Sistema, així que no se’n mostrarà cap." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Oznámení jsou pro Shrinker Pro vypnutá v Nastavení systému, takže se žádné neobjeví." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Notifikationer er slået fra for Shrinker Pro i Systemindstillinger, så der kommer ingen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Mitteilungen sind für Shrinker Pro in den Systemeinstellungen deaktiviert — es wird also keine geben." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Οι γνωστοποιήσεις για το Shrinker Pro είναι απενεργοποιημένες στις Ρυθμίσεις συστήματος, οπότε δεν θα εμφανιστεί καμία." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Las notificaciones de Shrinker Pro están desactivadas en Ajustes del Sistema, así que no aparecerá ninguna." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "اعلان‌های Shrinker Pro در تنظیمات سیستم خاموش است، بنابراین هیچ اعلانی نمایش داده نمی‌شود." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Shrinker Pron ilmoitukset on poistettu käytöstä Järjestelmäasetuksissa, joten niitä ei näytetä." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Les notifications sont désactivées pour Shrinker Pro dans Réglages Système : aucune n’apparaîtra." }

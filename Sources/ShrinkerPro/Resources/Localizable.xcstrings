    "Converts every raster file for the rest of this session. SVG and GIF are always left in their own format." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Converts every raster file for the rest of this session. SVG and GIF are always left in their own format." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يحوّل كل ملف نقطي فيما تبقى من هذه الجلسة. ويُترك SVG وGIF دائمًا بتنسيقهما الأصلي." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Converteix tots els arxius de mapa de bits durant la resta d’aquesta sessió. L’SVG i el GIF sempre es deixen en el seu format." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Převede každý rastrový soubor po zbytek této relace. SVG a GIF vždy zůstanou ve vlastním formátu." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Konverterer alle rasterarkiver resten af denne session. SVG og GIF bliver altid i deres eget format." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Konvertiert für den Rest dieser Sitzung jede Rasterdatei. SVG und GIF bleiben immer in ihrem eigenen Format." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Μετατρέπει κάθε αρχείο ράστερ για το υπόλοιπο αυτής της συνεδρίας. Τα SVG και GIF παραμένουν πάντα στη δική τους μορφή." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Convierte todos los archivos de mapa de bits durante el resto de esta sesión. SVG y GIF se mantienen siempre en su propio formato." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "تا پایان این جلسه هر فایل رستری را تبدیل می‌کند. SVG و GIF همیشه در قالب خودشان باقی می‌مانند." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Muuntaa jokaisen rasteritiedoston tämän istunnon loppuun asti. SVG ja GIF jätetään aina omaan muotoonsa." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Convertit tous les fichiers matriciels pour le reste de cette session. SVG et GIF sont toujours conservés dans leur propre format." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "ממיר כל קובץ רסטר עד סוף ההפעלה הזו. קבצי SVG ו-GIF נשארים תמיד בפורמט שלהם." }

# Template for the Homebrew *cask* — the GUI app, as opposed to
# homebrew/shrinker.rb.template, which is the formula for the headless
# `shrinker` CLI. Two different things, published side by side in the same
# personal tap:
#
#   brew install jeso87/tap/shrinker            # the command
#   brew install --cask jeso87/tap/shrinker-pro  # the app
#
# scripts/release.sh fills in @@VERSION@@, @@SHA256@@ and @@REPO@@ and writes
# the result to dist/shrinker-pro.rb, for the same reason the formula is
# generated: the sha256 cannot be known until the DMG exists, and a cask
# maintained by hand eventually points at bytes that are no longer there.
#
# WHERE THIS GOES. The tap, as Casks/shrinker-pro.rb, on every release. The
# better home is homebrew-cask proper (Homebrew/homebrew-cask), where `brew
# install --cask shrinker-pro` works without adding anything first — but it
# has a notability bar, expressed as GitHub stars, forks and watchers, with a
# higher bar still for a submission by the repository's owner. Until the repo
# clears it, the tap is the home. Check the current numbers in Homebrew's
# Package-Acceptance-Policy.md before submitting rather than trusting this
# comment; a cask that moves to homebrew-cask later is the same file.
cask "shrinker-pro" do
  arch arm: "arm64"

  version "@@VERSION@@"
  sha256 "@@SHA256@@"

  url "https://github.com/@@REPO@@/releases/download/v#{version}/ShrinkerPro-#{version}.dmg"
  name "Shrinker Pro"
  desc "Minify images and graphics"
  homepage "https://shrinkerpro.app/"

  # The appcast is the app's own Sparkle feed, which is generated from the
  # same build this cask points at, so the two can never disagree about what
  # the latest version is. The feed carries the build number too ("1.5.0,10");
  # the cask's version is the marketing version alone.
  livecheck do
    url "https://jeso87.github.io/ShrinkerPro/appcast.xml"
    strategy :sparkle, &:short_version
  end

  # Sparkle updates the app in place. Without this, Homebrew's recorded
  # version goes stale after the first in-app update, and `brew upgrade`
  # would try to replace an app that is already newer than it thinks.
  auto_updates true
  # Apple Silicon only, by construction rather than by preference: every
  # Mach-O in the bundle is arm64 and a build gate blocks the release if any
  # Intel slice appears. Declaring this stops Homebrew offering it on an
  # Intel Mac, where it cannot run at all. `:sonoma` means Sonoma or later.
  depends_on arch: :arm64
  depends_on macos: :sonoma

  app "Shrinker Pro.app"

  # The CLI is a separate formula rather than a binary stanza here. It is
  # built and signed separately, and someone who wants only the command
  # should not have to install the app to get it.

  zap trash: [
    "~/Library/Caches/com.eightseven.shrinkerpro",
    "~/Library/HTTPStorages/com.eightseven.shrinkerpro",
    "~/Library/Preferences/com.eightseven.shrinkerpro.plist",
  ]
end

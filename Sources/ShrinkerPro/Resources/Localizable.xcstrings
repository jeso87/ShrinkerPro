    "%lld files · %@ larger" : {
      "comment" : "Recent header aggregate when this session's outputs grew overall. First placeholder is the file count, second is a size such as '1.2 MB'. The one-file form reads '1 file' with no number of its own.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "1 file · %2$@ larger" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "%1$lld files · %2$@ larger" }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "1 Datei · %2$@ größer" }

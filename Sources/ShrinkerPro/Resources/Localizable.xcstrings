    "PNG is lossless — photos will usually get larger." : {
      "comment" : "Warning when the session's format override is PNG, which usually grows photographs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG is lossless — photos will usually get larger." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG بلا فقدان — والصور الفوتوغرافية تكبر عادةً." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG je bezztrátový — fotky se obvykle zvětší." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG ist verlustfrei — Fotos werden dadurch meist größer." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG es un formato sin pérdida — las fotos suelen acabar ocupando más." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG est sans perte — les photos deviendront généralement plus lourdes." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "פורמט PNG הוא ללא אובדן נתונים — תצלומים בדרך כלל יגדלו." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG è senza perdita di qualità — di solito le foto diventano più pesanti." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "PNGは可逆圧縮のため、写真はたいてい大きくなります。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG는 무손실이므로 사진은 대개 더 커집니다." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG is verliesloos — foto's worden er meestal groter van." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG jest bezstratny — zdjęcia zwykle się powiększą." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG é sem perdas — as fotos geralmente ficam maiores." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG сжимает без потерь — фотографии обычно станут больше." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG är förlustfritt — foton blir oftast större." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG — формат без втрат, тож фото зазвичай стають більшими." }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG 是无损格式，照片通常会变大。" }
        }
      }
    },

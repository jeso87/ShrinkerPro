    "A crop needs both sides. Fill in the other number, or clear this one — files cannot be shrunk until you do." : {
      "comment" : "Help text for the warning glyph shown while a crop has only one side filled in.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "A crop needs both sides. Fill in the other number, or clear this one — files cannot be shrunk until you do." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "الاقتصاص يحتاج إلى الجانبين معًا. أدخل الرقم الآخر أو امسح هذا الرقم — لا يمكن تصغير الملفات قبل ذلك." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Un escapçament necessita els dos costats. Omple l’altre número o esborra aquest — fins que no ho facis, no es pot reduir cap arxiu." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Ořez potřebuje obě strany. Doplňte druhé číslo, nebo toto smažte — do té doby nelze soubory zmenšovat." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "En beskæring kræver begge sider. Udfyld det andet tal, eller ryd dette — der kan ikke krympes arkiver, før du gør det." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Ein Zuschnitt braucht beide Seiten. Ergänze die andere Zahl oder entferne diese — bis dahin lassen sich keine Dateien verkleinern." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Η περικοπή χρειάζεται και τις δύο πλευρές. Συμπληρώστε τον άλλο αριθμό ή διαγράψτε αυτόν — μέχρι τότε δεν είναι δυνατή η σμίκρυνση αρχείων." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Un recorte necesita los dos lados. Escribe el otro número o borra este — hasta entonces no se puede reducir ningún archivo." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "برش به هر دو ضلع نیاز دارد. عدد دیگر را وارد کنید یا این یکی را پاک کنید — تا آن زمان فایل‌ها کوچک نمی‌شوند." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Rajaus tarvitsee molemmat sivut. Täytä toinen luku tai tyhjennä tämä — siihen asti tiedostoja ei voi pienentää." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Un recadrage a besoin de ses deux côtés. Saisissez l’autre nombre, ou effacez celui-ci — d’ici là, aucun fichier ne peut être réduit." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "חיתוך דורש את שתי הצלעות. יש למלא את המספר השני או לנקות את זה — עד אז לא ניתן לכווץ קבצים." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Rezanje treba obje stranice. Unesite drugi broj ili obrišite ovaj — do tada se datoteke ne mogu smanjiti." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "A vágáshoz mindkét oldal kell. Töltse ki a másik számot, vagy törölje ezt — addig egyetlen fájl sem tömöríthető." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Tilskurður þarf báðar hliðar. Fylltu inn hina töluna eða hreinsaðu þessa — engar skrár verða minnkaðar fyrr en þú gerir það." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Un ritaglio ha bisogno di entrambi i lati. Inserisci l’altro numero, oppure cancella questo — fino ad allora non è possibile ridurre alcun file." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "切り取りには両方の辺が必要です。もう一方の数値を入力するか、こちらを消してください。それまでファイルは圧縮できません。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "자르기에는 두 변이 모두 필요합니다. 나머지 숫자를 입력하거나 이 숫자를 지우십시오. 그때까지는 파일을 압축할 수 없습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "En beskjæring trenger begge sidene. Fyll inn det andre tallet, eller tøm dette — ingen filer kan krympes før du gjør det." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Een uitsnede heeft beide zijden nodig. Vul het andere getal in of wis dit getal — tot dan kunnen er geen bestanden worden verkleind." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Ei beskjering treng begge sidene. Fyll inn det andre talet, eller tøm dette — ingen filer kan krympast før du gjer det." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Kadrowanie wymaga obu boków. Uzupełnij drugą liczbę lub usuń tę — do tego czasu nie można zmniejszać plików." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Um recorte precisa dos dois lados. Preencha o outro número, ou limpe este — até lá, nenhum arquivo pode ser reduzido." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Um recorte precisa dos dois lados. Preencha o outro número, ou limpe este — até lá, não é possível reduzir ficheiros." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "O decupare are nevoie de ambele laturi. Completați celălalt număr sau ștergeți-l pe acesta — până atunci, fișierele nu pot fi micșorate." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Для обрезки нужны обе стороны. Укажите второе число или очистите это — до тех пор файлы уменьшать нельзя." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Orez potrebuje obe strany. Doplňte druhé číslo alebo toto vymažte — dovtedy sa súbory nedajú zmenšiť." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Obrezek potrebuje obe strani. Vnesite drugo številko ali počistite to — do takrat datotek ni mogoče zmanjšati." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "En beskärning behöver båda sidorna. Fyll i den andra siffran, eller rensa den här — inga filer kan krympas förrän du gör det." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "การครอบตัดต้องมีทั้งสองด้าน กรอกตัวเลขอีกช่องหนึ่งหรือล้างช่องนี้ — มิฉะนั้นจะบีบอัดไฟล์ไม่ได้" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Kırpma için iki kenar da gerekir. Diğer sayıyı girin ya da bunu temizleyin — o zamana kadar dosyalar küçültülemez." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Для обтинання потрібні обидві сторони. Введіть друге число або очистіть це — доти зменшити файли не вдасться." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Cắt xén cần cả hai cạnh. Hãy điền số còn lại, hoặc xóa số này — không thể nén tệp cho đến khi bạn làm vậy." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "裁剪需要兩邊。請填寫另一個數字，或清除這一個；在此之前無法壓縮檔案。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "裁剪需要两条边。请填写另一个数字，或清除这一个；在此之前无法压缩文件。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "裁切需要兩條邊。請填寫另一個數字，或清除這一個；在此之前無法壓縮檔案。" }
        }
      }
    },
    "Both sides are needed. The shape is used exactly as typed, so a portrait photo cropped to 16:9 comes out as a landscape strip. SVG is unaffected. Not saved — it resets when you quit." : {
      "comment" : "Shared tail of both crop help texts.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Both sides are needed. The shape is used exactly as typed, so a portrait photo cropped to 16:9 comes out as a landscape strip. SVG is unaffected. Not saved — it resets when you quit." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "الجانبان مطلوبان معًا. وتُستخدم النسبة كما تُكتب تمامًا، فالصورة الطولية المقتصَّة إلى 16:9 تخرج شريطًا عرضيًا. لا يتأثر SVG. ولا يُحفظ هذا الإعداد — فهو يعود إلى حالته الأولى عند الإنهاء." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Calen els dos costats. La forma s’utilitza tal com l’escrius: una foto vertical escapçada a 16:9 surt com una tira apaïsada. L’SVG no es veu afectat. No es desa — es restableix quan surts." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Potřeba jsou obě strany. Tvar se použije přesně tak, jak ho zadáte, takže z fotky na výšku oříznuté na 16:9 vznikne pruh na šířku. SVG zůstane beze změny. Neukládá se — po ukončení aplikace se vrátí do výchozího stavu." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Begge sider er nødvendige. Formen bruges nøjagtigt, som den er skrevet, så et stående foto beskåret til 16:9 kommer ud som en liggende strimmel. SVG påvirkes ikke. Gemmes ikke — det nulstilles, når du slutter appen." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Beide Seiten werden gebraucht. Die Form wird genau so verwendet, wie sie eingetippt ist: Ein Hochformat-Foto auf 16:9 zugeschnitten ergibt einen querformatigen Streifen. SVG bleibt unberührt. Wird nicht gesichert — beim Beenden setzt sie sich zurück." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Χρειάζονται και οι δύο πλευρές. Το σχήμα χρησιμοποιείται ακριβώς όπως το πληκτρολογείτε, οπότε μια κατακόρυφη φωτογραφία περικομμένη σε 16:9 βγαίνει ως οριζόντια λωρίδα. Τα SVG δεν επηρεάζονται. Δεν αποθηκεύεται — επανέρχεται όταν τερματίζετε την εφαρμογή." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Hacen falta los dos lados. La forma se usa exactamente como la escribes, así que una foto vertical recortada a 16:9 sale como una franja horizontal. SVG no se ve afectado. No se guarda — se restablece al salir." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "هر دو ضلع لازم است. شکل دقیقاً همان‌طور که تایپ می‌کنید به کار می‌رود، بنابراین یک عکس عمودی که به 16:9 بریده شود به صورت نواری افقی درمی‌آید. SVG تحت تأثیر قرار نمی‌گیرد. ذخیره نمی‌شود — با خروج از برنامه بازنشانی می‌شود." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Molempia sivuja tarvitaan. Muotoa käytetään täsmälleen kirjoitetussa muodossa, joten pystykuva 16:9-muotoon rajattuna tulee ulos vaakasuuntaisena kaistaleena. SVG ei muutu. Ei tallenneta — palautuu, kun lopetat." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Les deux côtés sont nécessaires. La forme est utilisée exactement telle qu’elle est saisie : une photo en portrait recadrée en 16:9 ressort en bande paysage. SVG n’est pas concerné. Non enregistré — le réglage se réinitialise quand vous quittez l’app." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "יש צורך בשתי הצלעות. הצורה משמשת בדיוק כפי שהוקלדה, ולכן תצלום לאורך שנחתך ליחס 16:9 יוצא כרצועה לרוחב. קבצי SVG אינם מושפעים. הערך אינו נשמר — הוא מתאפס עם סיום היישום." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Potrebne su obje stranice. Oblik se koristi točno onako kako ga upišete, pa uspravna fotografija izrezana na 16:9 ispada kao vodoravna traka. Na SVG ne utječe. Ne sprema se — pri zatvaranju aplikacije vraća se na početno stanje." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Mindkét oldal szükséges. Az alak pontosan úgy érvényesül, ahogy beírja, ezért egy álló fotó 16:9-re vágva fekvő sávként jön ki. Az SVG-t nem érinti. Nem kerül mentésre — kilépéskor visszaáll." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Það þarf báðar hliðar. Formið er notað nákvæmlega eins og það er slegið inn, svo að ljósmynd í lóðréttu sniði sem er skorin í 16:9 kemur út sem lárétt ræma. SVG verður ekki fyrir áhrifum. Ekki vistað — það núllstillist þegar þú hættir." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Servono entrambi i lati. La forma viene usata esattamente come la digiti: una foto verticale ritagliata a 16:9 esce come una striscia orizzontale. SVG non è interessato. Non viene salvata — si azzera quando esci dall’app." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "両方の辺が必要です。形は入力したとおりに使われるため、縦長の写真を16:9で切り取ると横長の帯になります。SVGは影響を受けません。保存されないため、終了するとリセットされます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "두 변이 모두 필요합니다. 입력한 그대로 적용되므로, 세로 사진을 16:9로 자르면 가로로 긴 띠가 됩니다. SVG는 영향을 받지 않습니다. 저장되지 않으며, 종료하면 초기화됩니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Begge sidene trengs. Formen brukes nøyaktig slik du skriver den, så et stående foto beskåret til 16:9 kommer ut som en liggende stripe. SVG påvirkes ikke. Lagres ikke — det nullstilles når du avslutter." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Beide zijden zijn nodig. De vorm wordt precies zo gebruikt als je hem typt: een staande foto die tot 16:9 wordt bijgesneden, komt er als een liggende strook uit. SVG blijft ongemoeid. Wordt niet bewaard — als je stopt, valt dit terug op de standaard." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Begge sidene trengst. Forma blir brukt nøyaktig slik du skriv ho, så eit ståande foto beskore til 16:9 kjem ut som ei liggjande remse. SVG blir ikkje påverka. Blir ikkje lagra — det blir nullstilt når du avsluttar." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Potrzebne są oba boki. Kształt jest używany dokładnie tak, jak go wpiszesz, więc zdjęcie pionowe skadrowane do 16:9 wyjdzie jako poziomy pasek. SVG pozostaje nietknięty. Nie jest zachowywane — po zakończeniu aplikacji wraca do stanu wyjściowego." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Os dois lados são necessários. A forma é usada exatamente como você digita, então uma foto em retrato recortada em 16:9 sai como uma faixa em paisagem. SVG não é afetado. Não é salvo — se redefine quando você encerra o app." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "São necessários os dois lados. A forma é usada exatamente como a escreve, pelo que uma fotografia vertical recortada para 16:9 sai como uma faixa horizontal. Os ficheiros SVG não são afetados. Não fica guardada — é reposta ao sair da aplicação." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Sunt necesare ambele laturi. Forma este folosită exact așa cum o tastați: o fotografie în format portret decupată la 16:9 iese ca o fâșie în format peisaj. SVG nu este afectat. Nu se salvează — se resetează când închideți aplicația." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Нужны обе стороны. Форма используется ровно так, как её ввели: вертикальное фото, обрезанное до 16:9, выйдет горизонтальной полосой. SVG не затрагивается. Не сохраняется — при завершении программы сбрасывается." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Potrebné sú obe strany. Tvar sa použije presne tak, ako ho zadáte, takže fotka na výšku orezaná na 16:9 vyjde ako pruh na šírku. SVG sa to netýka. Neukladá sa — po ukončení aplikácie sa resetuje." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Potrebni sta obe strani. Oblika se uporabi natanko tako, kot jo vnesete, zato pokončna fotografija, obrezana na 16:9, postane ležeč pas. Na SVG to ne vpliva. Ni shranjeno — ob zapiranju aplikacije se ponastavi." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Båda sidorna behövs. Formen används precis som du skriver den, så ett stående foto beskuret till 16:9 kommer ut som en liggande remsa. SVG påverkas inte. Sparas inte — den återställs när du avslutar." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "ต้องมีทั้งสองด้าน รูปทรงจะถูกใช้ตามที่พิมพ์ทุกประการ ภาพแนวตั้งที่ครอบตัดเป็น 16:9 จึงออกมาเป็นแถบแนวนอน SVG ไม่ได้รับผลกระทบ ค่านี้ไม่ถูกบันทึกไว้ และจะรีเซ็ตเมื่อคุณออกจากแอป" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "İki kenar da gereklidir. Biçim tam olarak yazdığınız gibi kullanılır; bu yüzden 16:9 olarak kırpılan dikey bir fotoğraf yatay bir şerit hâlinde çıkar. SVG etkilenmez. Kaydedilmez — uygulamadan çıktığınızda sıfırlanır." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Потрібні обидві сторони. Форма застосовується точно так, як її введено, тож вертикальне фото, обітнуте до 16:9, вийде горизонтальною смугою. SVG це не стосується. Не зберігається — скидається, коли ви завершуєте програму." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Cần cả hai cạnh. Hình dạng được dùng đúng như bạn nhập, nên ảnh dọc cắt xén theo 16:9 sẽ thành một dải ngang. SVG không bị ảnh hưởng. Giá trị này không được lưu — nó đặt lại khi bạn thoát." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "兩邊都要填寫。形狀會完全按照你輸入的數值使用，所以一張直向的相片裁剪成16:9之後，會變成一條橫向的窄條。SVG不受影響。此設定不會儲存，結束時就會還原。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "两条边都需要填写。形状会完全按照输入的方式使用，因此一张竖幅照片裁剪为 16:9 后会变成横向的窄条。SVG 不受影响。此设置不会存储，退出时即还原。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "兩條邊都需要填寫。形狀會完全依照輸入的內容使用，因此直式照片裁切為16:9後會變成橫式的長條。SVG不受影響。此設定不會儲存，結束時即重置。" }
        }
      }
    },
    "Crops the center of each image to this shape and leaves the size alone. The session's max size, if set, still applies." : {
      "comment" : "Crop help in ratio mode, where the crop sets shape but not size.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Crops the center of each image to this shape and leaves the size alone. The session's max size, if set, still applies." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يقتصّ مركز كل صورة إلى هذه النسبة ويترك الحجم كما هو. ويظل الحد الأقصى للحجم في هذه الجلسة ساريًا إن كان محددًا." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Escapça el centre de cada imatge segons aquesta forma i no toca la mida. La mida màxima de la sessió, si n’hi ha, continua aplicant-se." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Ořízne střed každého obrázku na tento tvar a velikost nechá být. Maximální velikost relace, pokud je nastavená, platí dál." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskærer midten af hvert billede til denne form og lader størrelsen være. Sessionens maks. størrelse gælder stadig, hvis der er angivet en." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Schneidet die Mitte jedes Bildes auf diese Form zu und lässt die Größe unangetastet. Die Maximalgröße der Sitzung gilt weiterhin, sofern eine gesetzt ist." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Περικόπτει το κέντρο κάθε εικόνας σε αυτό το σχήμα και αφήνει το μέγεθος ως έχει. Το μέγιστο μέγεθος της συνεδρίας, αν έχει οριστεί, εξακολουθεί να ισχύει." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Recorta el centro de cada imagen con esta forma y deja el tamaño intacto. El tamaño máx. de la sesión, si lo has definido, se sigue aplicando." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "مرکز هر تصویر را به این شکل می‌برد و اندازه را دست‌نخورده می‌گذارد. حداکثر اندازهٔ این جلسه، اگر تعیین شده باشد، همچنان اعمال می‌شود." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Rajaa jokaisen kuvan keskeltä tähän muotoon ja jättää koon ennalleen. Istunnon maksimikoko on yhä voimassa, jos se on asetettu." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Recadre le centre de chaque image selon cette forme et laisse la taille inchangée. La taille max. de la session, si elle est définie, s’applique toujours." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "חותך את מרכז כל תמונה לצורה הזו ומשאיר את הגודל כמו שהוא. הגודל המרבי של ההפעלה, אם הוגדר, עדיין חל." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Reže sredinu svake slike na ovaj oblik i ne dira veličinu. Maks. veličina sesije, ako je postavljena, i dalje vrijedi." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Minden kép közepét erre az alakra vágja, a méretet pedig változatlanul hagyja. A munkamenet max. mérete, ha be van állítva, továbbra is érvényes." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Sker miðju hverrar myndar í þetta form og lætur stærðina í friði. Hámarksstærð lotunnar gildir áfram ef hún er stillt." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Ritaglia il centro di ogni immagine secondo questa forma e lascia invariata la dimensione. La dimensione max. della sessione, se impostata, continua a valere." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "各画像の中央をこの形に切り取り、サイズはそのままにします。セッションの最大サイズを設定している場合は、そちらも引き続き適用されます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "각 이미지의 가운데를 이 모양으로 자르고 크기는 그대로 둡니다. 세션의 최대 크기를 설정한 경우 계속 적용됩니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskjærer midten av hvert bilde til denne formen og lar størrelsen være. Øktens maks. størrelse gjelder fortsatt, hvis den er angitt." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Snijdt elke afbeelding vanuit het midden bij tot deze vorm en laat de grootte ongemoeid. De max. grootte van de sessie geldt nog steeds, als die is ingesteld." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskjer midten av kvart bilete til denne forma og lèt storleiken vere. Maksstorleiken for økta gjeld framleis, om han er sett." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Kadruje środek każdego obrazu do tego kształtu i nie zmienia rozmiaru. Maksymalny rozmiar sesji, jeśli jest ustawiony, nadal obowiązuje." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Recorta o centro de cada imagem nesta forma e não mexe no tamanho. O tamanho máx. da sessão, se estiver definido, continua valendo." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Recorta o centro de cada imagem nesta forma e não altera o tamanho. O tamanho máx. da sessão, se estiver definido, continua a aplicar-se." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Decupează centrul fiecărei imagini la această formă și lasă dimensiunea neatinsă. Dimensiunea max. a sesiunii, dacă este stabilită, se aplică în continuare." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Обрезает центр каждого изображения до этой формы и не меняет размер. Максимальный размер сеанса, если он задан, продолжает действовать." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Oreže stred každého obrázka na tento tvar a veľkosť ponechá. Max. veľkosť relácie, ak je nastavená, stále platí." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Obreže sredino vsake slike na to obliko in ne spremeni velikosti. Največja velikost seje, če je nastavljena, še vedno velja." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskär mitten av varje bild till den här formen och lämnar storleken orörd. Sessionens maxstorlek gäller fortfarande, om någon är angiven." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "ครอบตัดกึ่งกลางของแต่ละรูปภาพให้เป็นรูปทรงนี้โดยไม่เปลี่ยนขนาด หากตั้งขนาดสูงสุดของเซสชั่นไว้ ค่านั้นยังมีผลอยู่" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Her görüntünün ortasını bu biçime kırpar ve boyutuna dokunmaz. Oturumun en büyük boyutu ayarlanmışsa yine de geçerlidir." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Обтинає центр кожного зображення до цієї форми й не змінює розмір. Максимальний розмір сеансу, якщо його задано, усе одно діє." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Cắt xén phần giữa của mỗi hình ảnh theo hình dạng này và giữ nguyên kích cỡ. Nếu đã đặt kích cỡ tối đa cho phiên, giá trị đó vẫn được áp dụng." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "將每張影像的中央裁剪成這個形狀，尺寸維持不變。如果今次設定了最大尺寸，該設定仍然生效。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "将每张图片的中心裁剪为这个形状，尺寸保持不变。如果设置了本次会话的最大尺寸，它仍然生效。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "將每張影像的中央裁切為這個形狀，尺寸維持不變。若已設定本次工作階段的最大尺寸，該設定仍然有效。" }
        }
      }
    },
    "Crops the center of each image to this shape, then scales it down to this size. Images already smaller are cropped but never enlarged, so a mixed batch may not come out all one size. This sets the output size outright, so the max size above does not apply." : {
      "comment" : "Crop help in pixel mode, where the crop states the output size outright.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Crops the center of each image to this shape, then scales it down to this size. Images already smaller are cropped but never enlarged, so a mixed batch may not come out all one size. This sets the output size outright, so the max size above does not apply." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يقتصّ مركز كل صورة إلى هذه النسبة ثم يصغّرها إلى هذا الحجم. والصور الأصغر من ذلك تُقتصّ ولا تُكبَّر أبدًا، لذا قد لا تخرج الدفعة المختلطة بحجم واحد. وهذا يحدد حجم المُخرجات تمامًا، فلا ينطبق الحد الأقصى للحجم أعلاه." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Escapça el centre de cada imatge segons aquesta forma i després la redueix fins a aquesta mida. Les imatges que ja són més petites s’escapcen, però mai no s’amplien, de manera que un lot mixt pot no sortir tot d’una mida. Això fixa la mida de sortida, així que la mida màxima de dalt no s’aplica." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Ořízne střed každého obrázku na tento tvar a pak ho zmenší na tuto velikost. Obrázky, které už jsou menší, se oříznou, ale nikdy nezvětší, takže smíšená dávka nemusí vyjít celá ve stejné velikosti. Tím je výstupní velikost dána napevno, takže maximální velikost výše neplatí." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskærer midten af hvert billede til denne form og skalerer det derefter ned til denne størrelse. Billeder, der allerede er mindre, bliver beskåret, men aldrig forstørret, så en blandet bunke kommer måske ikke ud i én og samme størrelse. Det fastlægger outputstørrelsen direkte, så maks. størrelsen ovenfor gælder ikke." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Schneidet die Mitte jedes Bildes auf diese Form zu und skaliert es dann auf diese Größe herunter. Bereits kleinere Bilder werden zugeschnitten, aber nie vergrößert — ein gemischter Stapel kommt deshalb womöglich nicht in einer einheitlichen Größe heraus. Damit steht die Ausgabegröße fest, und die Maximalgröße darüber gilt nicht." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Περικόπτει το κέντρο κάθε εικόνας σε αυτό το σχήμα και έπειτα τη σμικρύνει σε αυτό το μέγεθος. Οι εικόνες που είναι ήδη μικρότερες περικόπτονται αλλά ποτέ δεν μεγεθύνονται, οπότε μια μεικτή παρτίδα μπορεί να μη βγει όλη στο ίδιο μέγεθος. Αυτό ορίζει απευθείας το μέγεθος εξόδου, οπότε το παραπάνω μέγιστο μέγεθος δεν ισχύει." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Recorta el centro de cada imagen con esta forma y luego la reduce a este tamaño. Las imágenes que ya son más pequeñas se recortan, pero nunca se amplían, así que un lote heterogéneo puede no salir todo del mismo tamaño. Esto fija el tamaño de salida, de modo que el tamaño máx. de arriba no se aplica." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "مرکز هر تصویر را به این شکل می‌برد و سپس آن را تا این اندازه کوچک می‌کند. تصاویری که از پیش کوچک‌ترند بریده می‌شوند اما هرگز بزرگ نمی‌شوند، بنابراین ممکن است یک دستهٔ ناهمگون همه در یک اندازه بیرون نیاید. این کار اندازهٔ خروجی را یکسره تعیین می‌کند، پس حداکثر اندازهٔ بالا اعمال نمی‌شود." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Rajaa jokaisen kuvan keskeltä tähän muotoon ja skaalaa sen sitten tähän kokoon. Jo valmiiksi pienemmät kuvat rajataan mutta niitä ei koskaan suurenneta, joten sekalainen erä ei välttämättä tule ulos yhtenä kokona. Tämä määrää tulostekoon suoraan, joten yllä oleva maksimikoko ei päde." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Recadre le centre de chaque image selon cette forme, puis la redimensionne à cette taille. Les images déjà plus petites sont recadrées, mais jamais agrandies : un lot hétérogène peut donc ne pas ressortir d’une seule taille. La taille de sortie est ainsi fixée, et la taille max. ci-dessus ne s’applique pas." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "חותך את מרכז כל תמונה לצורה הזו ואז מקטין אותה לגודל הזה. תמונות שכבר קטנות יותר נחתכות אך לעולם אינן מוגדלות, ולכן אצווה מעורבת עשויה לצאת בגדלים שונים. כך נקבע גודל הפלט באופן מוחלט, ולכן הגודל המרבי שלמעלה אינו חל." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Reže sredinu svake slike na ovaj oblik, a zatim je skalira na ovu veličinu. Slike koje su već manje režu se, ali se nikad ne povećavaju, pa mješovita serija možda neće ispasti u jednoj veličini. Time je izlazna veličina zadana izravno, pa maks. veličina iznad ne vrijedi." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Minden kép közepét erre az alakra vágja, majd erre a méretre kicsinyíti. A már eleve kisebb képeket levágja, de soha nem nagyítja fel, ezért egy vegyes köteg nem feltétlenül lesz egyforma méretű. Ez közvetlenül megadja a kimeneti méretet, így a fenti max. méret nem érvényes." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Sker miðju hverrar myndar í þetta form og minnkar hana síðan niður í þessa stærð. Myndir sem eru þegar minni eru skornar en aldrei stækkaðar, svo að blandaður hópur kemur kannski ekki allur út í sömu stærð. Þetta ákveður úttaksstærðina beint, svo að hámarksstærðin hér að ofan gildir ekki." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Ritaglia il centro di ogni immagine secondo questa forma, poi la riduce a questa dimensione. Le immagini già più piccole vengono ritagliate, ma mai ingrandite: un lotto misto può quindi non uscire tutto della stessa dimensione. In questo modo la dimensione di output è già fissata e la dimensione max. qui sopra non si applica." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "各画像の中央をこの形に切り取り、このサイズまで縮小します。すでに小さい画像は切り取られますが拡大はされないため、大きさがまちまちのバッチでは仕上がりのサイズがそろわないことがあります。これで出力サイズが決まるため、上の最大サイズは適用されません。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "각 이미지의 가운데를 이 모양으로 자른 다음 이 크기로 축소합니다. 이미 더 작은 이미지는 잘리기만 하고 확대되지 않으므로, 크기가 섞인 묶음은 결과 크기가 모두 같지 않을 수 있습니다. 이 설정이 출력 크기를 직접 정하므로, 위의 최대 크기는 적용되지 않습니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskjærer midten av hvert bilde til denne formen og skalerer det deretter ned til denne størrelsen. Bilder som allerede er mindre, blir beskåret, men aldri forstørret, så en blandet bunke kommer kanskje ikke ut i én og samme størrelse. Dette angir utdatastørrelsen direkte, så maks. størrelsen ovenfor gjelder ikke." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Snijdt elke afbeelding vanuit het midden bij tot deze vorm en schaalt haar daarna terug naar deze grootte. Afbeeldingen die al kleiner zijn, worden wel bijgesneden maar nooit vergroot; bij een gemengde reeks komen ze er dus niet per se allemaal even groot uit. Hiermee ligt de uitvoergrootte vast, dus de max. grootte hierboven geldt niet." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskjer midten av kvart bilete til denne forma og skalerer det så ned til denne storleiken. Bilete som alt er mindre blir beskorne, men aldri forstørra, så ei blanda mengd kjem kanskje ikkje ut i éin og same storleik. Dette fastset utdatastorleiken direkte, så maksstorleiken ovanfor gjeld ikkje." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Kadruje środek każdego obrazu do tego kształtu, a następnie skaluje go w dół do tego rozmiaru. Obrazy już mniejsze są kadrowane, ale nigdy nie powiększane, więc mieszana partia może nie wyjść w jednym rozmiarze. To ustala rozmiar wyjściowy wprost, więc maksymalny rozmiar powyżej nie obowiązuje." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "Recorta o centro de cada imagem nesta forma e depois a reduz para este tamanho. Imagens que já são menores são recortadas, mas nunca ampliadas, então um lote misto pode não sair todo do mesmo tamanho. Isso define o tamanho de saída de uma vez, então o tamanho máx. acima não se aplica." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "Recorta o centro de cada imagem nesta forma e reduz-a depois para este tamanho. As imagens que já são mais pequenas são recortadas, mas nunca ampliadas, pelo que um lote misto pode não sair todo do mesmo tamanho. Isto define desde logo o tamanho de saída, pelo que o tamanho máx. acima não se aplica." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Decupează centrul fiecărei imagini la această formă, apoi o micșorează la această dimensiune. Imaginile deja mai mici sunt decupate, dar niciodată mărite, așa că un lot mixt poate să nu iasă tot la aceeași dimensiune. Astfel, dimensiunea de ieșire este stabilită direct, iar dimensiunea max. de mai sus nu se aplică." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Обрезает центр каждого изображения до этой формы, а затем уменьшает его до этого размера. Изображения, которые уже меньше, обрезаются, но никогда не увеличиваются, поэтому смешанная партия может выйти разного размера. Так размер результата задаётся напрямую, поэтому максимальный размер выше не действует." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Oreže stred každého obrázka na tento tvar a potom ho zmenší na túto veľkosť. Menšie obrázky sa orežú, ale nikdy sa nezväčšia, takže zmiešaná dávka nemusí vyjsť celá v jednej veľkosti. Toto určuje výstupnú veľkosť priamo, takže max. veľkosť vyššie neplatí." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Obreže sredino vsake slike na to obliko in jo nato pomanjša na to velikost. Slike, ki so že manjše, se obrežejo, nikoli pa ne povečajo, zato mešan paket morda ne bo ves v enotni velikosti. S tem je izhodna velikost določena neposredno, zato največja velikost zgoraj ne velja." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskär mitten av varje bild till den här formen och skalar sedan ned den till den här storleken. Bilder som redan är mindre beskärs men förstoras aldrig, så en blandad omgång kanske inte kommer ut i en enda storlek. Det här anger utdatastorleken rakt av, så maxstorleken ovanför gäller inte." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "ครอบตัดกึ่งกลางของแต่ละรูปภาพให้เป็นรูปทรงนี้ แล้วย่อลงเป็นขนาดนี้ รูปภาพที่เล็กกว่าอยู่แล้วจะถูกครอบตัดแต่ไม่ถูกขยาย ชุดที่มีขนาดคละกันจึงอาจออกมาไม่เท่ากันทั้งหมด ค่านี้กำหนดขนาดผลลัพธ์โดยตรง ขนาดสูงสุดด้านบนจึงไม่มีผล" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Her görüntünün ortasını bu biçime kırpar, sonra bu boyuta küçültür. Zaten daha küçük olan görüntüler kırpılır ama asla büyütülmez; bu yüzden karışık bir yığın tek bir boyutta çıkmayabilir. Bu, çıktı boyutunu doğrudan belirler; dolayısıyla yukarıdaki en büyük boyut geçerli olmaz." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Обтинає центр кожного зображення до цієї форми, а потім зменшує його до цього розміру. Зображення, які вже менші, обтинаються, але ніколи не збільшуються, тож змішана партія може вийти не одного розміру. Це прямо задає розмір на виході, тож максимальний розмір вище не діє." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Cắt xén phần giữa của mỗi hình ảnh theo hình dạng này, rồi thu nhỏ xuống kích cỡ này. Hình ảnh vốn đã nhỏ hơn sẽ được cắt xén nhưng không bao giờ được phóng to, nên một lô hỗn hợp có thể không ra cùng một kích cỡ. Cài đặt này ấn định thẳng kích cỡ đầu ra, nên kích cỡ tối đa ở trên không được áp dụng." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "將每張影像的中央裁剪成這個形狀，然後縮小到這個尺寸。本身較小的影像只會被裁剪，不會被放大，所以一批大小不一的影像輸出後可能不是同一個尺寸。這會直接決定輸出尺寸，所以上面的最大尺寸不適用。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "将每张图片的中心裁剪为这个形状，然后缩小到这个尺寸。本身更小的图片会被裁剪，但绝不会被放大，因此一批尺寸不一的图片输出后可能大小不一。这会直接决定输出尺寸，所以上面的最大尺寸不再适用。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "將每張影像的中央裁切為這個形狀，然後縮小到這個尺寸。本身較小的影像會被裁切，但絕不會被放大，因此一批尺寸不一的影像輸出後可能大小不同。這會直接決定輸出尺寸，所以上方的最大尺寸不再適用。" }
        }
      }
    },
    "Finish the crop, or clear it, before closing." : {
      "comment" : "Help text on the disabled Done button while the crop is missing a side.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Finish the crop, or clear it, before closing." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "أكمل الاقتصاص أو امسحه قبل الإغلاق." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "Acaba l’escapçament, o esborra’l, abans de tancar." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Před zavřením ořez dokončete, nebo ho smažte." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Færdiggør beskæringen, eller ryd den, før du lukker." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Vor dem Schließen muss der Zuschnitt vervollständigt oder entfernt werden." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Ολοκληρώστε την περικοπή ή διαγράψτε την πριν από το κλείσιμο." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Completa el recorte, o bórralo, antes de cerrar." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "پیش از بستن، برش را کامل کنید یا آن را پاک کنید." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Viimeistele rajaus tai tyhjennä se ennen sulkemista." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Complétez le recadrage, ou effacez-le, avant de fermer." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "יש להשלים את החיתוך או לנקות אותו לפני הסגירה." }
        },
        "hr" : {

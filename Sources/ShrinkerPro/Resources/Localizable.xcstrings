{
  "sourceLanguage" : "en",
  "strings" : {
    "%@  —  %@" : {
      "comment" : "One radio option's label in the Files/Filenames setting: the choice, then the filename it produces, in secondary text. Placeholders are the option's own title and the example filename it produces.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "%1$@  —  %2$@" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "%1$@  —  %2$@" }
        }
      }
    },
    "%@ → %@" : {
      "comment" : "A result row's before-and-after sizes. The arrow points from the original size to the shrunk size; in right-to-left languages it should point the other way (←).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "%1$@ → %2$@" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "%1$@ → %2$@" }
        }
      }
    },
    "Crop %@:%@" : {
      "comment" : "Collapsed session-bar summary of a ratio crop. Placeholders are the two sides of the ratio.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Crop %1$@:%2$@" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Zuschnitt %1$@:%2$@" }
        }
      }
    },
    "Crop %@×%@" : {
      "comment" : "Collapsed session-bar summary of a pixel crop. Placeholders are width and height in pixels; the × is the same glyph the field shows.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Crop %1$@×%2$@" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Zuschnitt %1$@×%2$@" }
        }
      }
    },
    "Max %@px" : {
      "comment" : "Collapsed session-bar summary of the max size. Placeholder is a pixel count; 'px' placement varies by language.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Max %@px" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Max. %@ px" }
        }
      }
    },
    "No limit" : {
      "comment" : "Collapsed session-bar summary when no max size is set.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "No limit" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Keine Begrenzung" }
        }
      }
    },
    "%@, …and %lld more" : {
      "comment" : "Tail of a truncated filename list. First placeholder is the listed names, second is how many were not listed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "%@, …and %lld more" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "%@, …und %lld weitere" }
        }
      }
    },
    "%lld files are already there: %@" : {
      "comment" : "Overwrite sheet body for existing files. First placeholder is the file count and drives the plural; the singular form does not print it. Second is the filename list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "%2$@ is already there and will be replaced." }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "These %1$lld files are already there and will be replaced: %2$@" }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "%2$@ ist bereits vorhanden und wird ersetzt." }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "Diese %1$lld Dateien sind bereits vorhanden und werden ersetzt: %2$@" }
              }
            }
          }
        }
      }
    },
    "%lld images shrunk" : {
      "comment" : "Notification title after a batch finishes. The one-file form reads 'Image shrunk' with no number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "Image shrunk" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "%lld images shrunk" }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "Bild verkleinert" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "%lld Bilder verkleinert" }
              }
            }
          }
        }
      }
    },
    "%lld originals will be overwritten: %@" : {
      "comment" : "Overwrite sheet body for originals. First placeholder is the file count and drives the plural; the singular form does not print it. Second is the filename list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "%2$@ will be overwritten and cannot be recovered." }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "These %1$lld originals will be overwritten and cannot be recovered: %2$@" }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "%2$@ wird überschrieben und kann nicht wiederhergestellt werden." }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "Diese %1$lld Originale werden überschrieben und können nicht wiederhergestellt werden: %2$@" }
              }
            }
          }
        }
      }
    },
    "A crop needs both sides. Fill in the other number, or clear this one — files cannot be shrunk until you do." : {
      "comment" : "Help text for the warning glyph shown while a crop has only one side filled in.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "A crop needs both sides. Fill in the other number, or clear this one — files cannot be shrunk until you do." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Ein Zuschnitt braucht beide Seiten. Ergänze die andere Zahl oder entferne diese — bis dahin lassen sich keine Dateien verkleinern." }
        }
      }
    },
    "Both sides are needed. The shape is used exactly as typed, so a portrait photo cropped to 16:9 comes out as a landscape strip. SVG is unaffected. Not saved — it resets when you quit." : {
      "comment" : "Shared tail of both crop help texts.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Both sides are needed. The shape is used exactly as typed, so a portrait photo cropped to 16:9 comes out as a landscape strip. SVG is unaffected. Not saved — it resets when you quit." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Beide Seiten werden gebraucht. Die Form wird genau so verwendet, wie sie eingetippt ist: Ein Hochformat-Foto auf 16:9 zugeschnitten ergibt einen querformatigen Streifen. SVG bleibt unberührt. Wird nicht gesichert — beim Beenden setzt sie sich zurück." }
        }
      }
    },
    "Crops the center of each image to this shape and leaves the size alone. The session's max size, if set, still applies." : {
      "comment" : "Crop help in ratio mode, where the crop sets shape but not size.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Crops the center of each image to this shape and leaves the size alone. The session's max size, if set, still applies." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Schneidet die Mitte jedes Bildes auf diese Form zu und lässt die Größe unangetastet. Die Maximalgröße der Sitzung gilt weiterhin, sofern eine gesetzt ist." }
        }
      }
    },
    "Crops the center of each image to this shape, then scales it down to this size. Images already smaller are cropped but never enlarged, so a mixed batch may not come out all one size. This sets the output size outright, so the max size above does not apply." : {
      "comment" : "Crop help in pixel mode, where the crop states the output size outright.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Crops the center of each image to this shape, then scales it down to this size. Images already smaller are cropped but never enlarged, so a mixed batch may not come out all one size. This sets the output size outright, so the max size above does not apply." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Schneidet die Mitte jedes Bildes auf diese Form zu und skaliert es dann auf diese Größe herunter. Bereits kleinere Bilder werden zugeschnitten, aber nie vergrößert — ein gemischter Stapel kommt deshalb womöglich nicht in einer einheitlichen Größe heraus. Damit steht die Ausgabegröße fest, und die Maximalgröße darüber gilt nicht." }
        }
      }
    },
    "Finish the crop, or clear it, before closing." : {
      "comment" : "Help text on the disabled Done button while the crop is missing a side.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Finish the crop, or clear it, before closing." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Vor dem Schließen muss der Zuschnitt vervollständigt oder entfernt werden." }
        }
      }
    },
    "Image conversion failed: %@" : {
      "comment" : "Alert body when an ImageIO decode or encode step fails.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Image conversion failed: %@" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Die Bildkonvertierung ist fehlgeschlagen: %@" }
        }
      }
    },
    "No output was written to %@." : {
      "comment" : "Alert body when a compressor reported success but produced no file.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "No output was written to %@." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Nach %@ wurde keine Ausgabe geschrieben." }
        }
      }
    },
    "Only SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC and HEIF are supported (got \"%@\")." : {
      "comment" : "Alert body when a dropped file is a format the app cannot read.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Only SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC and HEIF are supported (got \"%@\")." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Nur SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC und HEIF werden unterstützt (erhalten: „%@“)." }
        }
      }
    },
    "PNG is lossless — photos will usually get larger." : {
      "comment" : "Warning when the session's format override is PNG, which usually grows photographs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG is lossless — photos will usually get larger." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG ist verlustfrei — Fotos werden dadurch meist größer." }
        }
      }
    },
    "Replace %lld files in “%@”?" : {
      "comment" : "Overwrite sheet title for existing files sharing one folder. Second placeholder is the folder name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "Replace 1 file in “%2$@”?" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "Replace %1$lld files in “%2$@”?" }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "1 Datei in „%2$@“ ersetzen?" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "%1$lld Dateien in „%2$@“ ersetzen?" }
              }
            }
          }
        }
      }
    },
    "Replace %lld files?" : {
      "comment" : "Overwrite sheet title when existing files would be replaced and they are not all in one folder.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "Replace 1 file?" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "Replace %lld files?" }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "1 Datei ersetzen?" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "%lld Dateien ersetzen?" }
              }
            }
          }
        }
      }
    },
    "Replace %lld originals in “%@”?" : {
      "comment" : "Overwrite sheet title for originals sharing one folder. Second placeholder is the folder name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "Replace 1 original in “%2$@”?" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "Replace %1$lld originals in “%2$@”?" }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "1 Original in „%2$@“ ersetzen?" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "%1$lld Originale in „%2$@“ ersetzen?" }
              }
            }
          }
        }
      }
    },
    "Replace %lld originals?" : {
      "comment" : "Overwrite sheet title when the user's own originals would be destroyed and they are not all in one folder.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "Replace 1 original?" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "Replace %lld originals?" }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "1 Original ersetzen?" }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "%lld Originale ersetzen?" }
              }
            }
          }
        }
      }
    },
    "Shrinks images so the longest side is at most this many pixels. Smaller images are left alone. SVG is unaffected." : {
      "comment" : "Help text for the max size field when it is live.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Shrinks images so the longest side is at most this many pixels. Smaller images are left alone. SVG is unaffected." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Verkleinert Bilder so, dass die längste Seite höchstens so viele Pixel hat. Kleinere Bilder bleiben unverändert. SVG bleibt unberührt." }
        }
      }
    },
    "Skip These" : {
      "comment" : "Overwrite sheet's cancel-role button when more than one file is affected. Declines these files; the rest of the batch still runs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Skip These" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Diese Dateien überspringen" }
        }
      }
    },
    "Skip This" : {
      "comment" : "Overwrite sheet's cancel-role button when exactly one file is affected. Declines these files; the rest of the batch still runs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Skip This" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Diese Datei überspringen" }
        }
      }
    },
    "SVG optimization failed: %@" : {
      "comment" : "Alert body when svgo fails.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "SVG optimization failed: %@" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Die SVG-Optimierung ist fehlgeschlagen: %@" }
        }
      }
    },
    "The bundled %@ tool is missing. The app may be damaged — try reinstalling." : {
      "comment" : "Alert body when a bundled compressor binary is absent. The placeholder is a tool name such as cjpeg.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The bundled %@ tool is missing. The app may be damaged — try reinstalling." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Das mitgelieferte Werkzeug %@ fehlt. Die App ist möglicherweise beschädigt — installiere sie neu." }
        }
      }
    },
    "The crop already sets the size — every image comes out %@×%@. Switch the crop to a ratio, or clear it, to use a max size." : {
      "comment" : "Help text when a pixel crop makes the max size field irrelevant. Placeholders are the crop's width and height in pixels.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The crop already sets the size — every image comes out %1$@×%2$@. Switch the crop to a ratio, or clear it, to use a max size." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Der Zuschnitt legt die Größe bereits fest — jedes Bild kommt mit %1$@×%2$@ heraus. Stelle den Zuschnitt auf ein Verhältnis um oder entferne ihn, um eine Maximalgröße zu nutzen." }
        }
      }
    },
    "The other %lld files are unaffected." : {
      "comment" : "Reassurance that the rest of the batch still runs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "The other file is unaffected." }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "The other %lld files are unaffected." }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : { "state" : "translated", "value" : "Die übrige Datei ist nicht betroffen." }
              },
              "other" : {
                "stringUnit" : { "state" : "translated", "value" : "Die übrigen %lld Dateien sind nicht betroffen." }
              }
            }
          }
        }
      }
    },
    "filename list separator" : {
      "comment" : "Separates filenames in the overwrite sheet's list. English uses a comma and a space; CJK languages use 、",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : ", " }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : ", " }
        }
      }
    },
    "About Shrinker Pro" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "About Shrinker Pro" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Über Shrinker Pro" }
        }
      }
    },
    "Adjust session settings" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Adjust session settings" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Sitzungseinstellungen anpassen" }
        }
      }
    },
    "App default" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "App default" }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "App-Vorgabe" }
        }
      }
    },
    "Applies to JPEG, WebP, AVIF and HEIC. PNG and GIF are optimised by tools with no comparable setting, so they look the same whichever you choose." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Applies to JPEG, WebP, AVIF and HEIC. PNG and GIF are optimised by tools with no comparable setting, so they look the same whichever you choose." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Gilt für JPEG, WebP, AVIF und HEIC. PNG und GIF werden von Werkzeugen optimiert, die keine vergleichbare Einstellung haben, und sehen deshalb bei jeder Wahl gleich aus." }
        }
      }
    },
    "Applies to JPEG, WebP, AVIF and HEIC. PNG and GIF are optimised by tools with no comparable setting, so they look the same whichever you choose. Standard matches what earlier versions of Shrinker Pro produced. Every session starts here; the window's session bar can change it for one session without changing this." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Applies to JPEG, WebP, AVIF and HEIC. PNG and GIF are optimised by tools with no comparable setting, so they look the same whichever you choose. Standard matches what earlier versions of Shrinker Pro produced. Every session starts here; the window's session bar can change it for one session without changing this." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Gilt für JPEG, WebP, AVIF und HEIC. PNG und GIF werden von Werkzeugen optimiert, die keine vergleichbare Einstellung haben, und sehen deshalb bei jeder Wahl gleich aus. Standard entspricht dem, was frühere Versionen von Shrinker Pro erzeugt haben. Jede Sitzung beginnt hier; die Sitzungsleiste im Fenster kann den Wert für eine Sitzung ändern, ohne diese Einstellung zu ändern." }
        }
      }
    },
    "Applies to this session only. Defaults live in Settings." : {
      "extractionState" : "extracted_with_value",

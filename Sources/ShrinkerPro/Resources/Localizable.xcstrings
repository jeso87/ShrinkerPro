    "Only SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC and HEIF are supported (got \"%@\")." : {
      "comment" : "Alert body when a dropped file is a format the app cannot read.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Only SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC and HEIF are supported (got \"%@\")." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "التنسيقات المدعومة هي SVG وPNG وGIF وJPEG وWebP وAVIF وHEIC وHEIF فقط (ورد \"%@\")." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Nur SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC und HEIF werden unterstützt (erhalten: „%@“)." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Seuls SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC et HEIF sont pris en charge (reçu : « %@ »)." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "נתמכים רק SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC ו-HEIF (התקבל ״%@״)." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "対応しているのはSVG、PNG、GIF、JPEG、WebP、AVIF、HEIC、HEIFのみです(「%@」を受け取りました)。" }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Obsługiwane są tylko SVG, PNG, GIF, JPEG, WebP, AVIF, HEIC i HEIF (otrzymano „%@”)." }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "仅支持 SVG、PNG、GIF、JPEG、WebP、AVIF、HEIC 和 HEIF（收到“%@”）。" }
        }
      }
    },
    "PNG is lossless — photos will usually get larger." : {
      "comment" : "Warning when the session's format override is PNG, which usually grows photographs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG is lossless — photos will usually get larger." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG بلا فقدان — والصور الفوتوغرافية تكبر عادةً." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG ist verlustfrei — Fotos werden dadurch meist größer." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG est sans perte — les photos deviendront généralement plus lourdes." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "פורמט PNG הוא ללא אובדן נתונים — תצלומים בדרך כלל יגדלו." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "PNGは可逆圧縮のため、写真はたいてい大きくなります。" }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG jest bezstratny — zdjęcia zwykle się powiększą." }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "PNG 是无损格式，照片通常会变大。" }
        }
      }
    },

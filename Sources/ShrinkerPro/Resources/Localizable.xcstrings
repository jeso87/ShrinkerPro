    "%@ saved" : {
      "comment" : "Notification body after a batch of two or more files. The placeholder is an already-formatted size such as '1.2 MB'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "%@ saved" }
        },

    "The bundled %@ tool is missing. The app may be damaged — try reinstalling." : {
      "comment" : "Alert body when a bundled compressor binary is absent. The placeholder is a tool name such as cjpeg.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The bundled %@ tool is missing. The app may be damaged — try reinstalling." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "أداة %@ المُضمّنة مفقودة. قد يكون التطبيق تالفًا — جرّب إعادة تثبيته." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Přibalený nástroj %@ chybí. Aplikace je možná poškozená — zkuste ji nainstalovat znovu." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Das mitgelieferte Werkzeug %@ fehlt. Die App ist möglicherweise beschädigt — installiere sie neu." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "Falta la herramienta %@ incluida en la app. Puede que la app esté dañada — prueba a reinstalarla." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "L’outil %@ fourni avec l’app est introuvable. L’app est peut-être endommagée — réinstallez-la." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הכלי המצורף %@ חסר. ייתכן שהיישום פגום — ניתן לנסות להתקין אותו מחדש." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Lo strumento %@ incluso nell’app è mancante. L’app potrebbe essere danneggiata — prova a reinstallarla." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "同梱の%@ツールが見つかりません。Appが壊れている可能性があります。再インストールしてください。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "번들에 포함된 %@ 도구가 없습니다. 앱이 손상되었을 수 있으니 다시 설치해 보십시오." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "Het meegeleverde hulpprogramma %@ ontbreekt. De app is mogelijk beschadigd — installeer hem opnieuw." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Brakuje dołączonego narzędzia %@. Aplikacja może być uszkodzona — zainstaluj ją ponownie." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "A ferramenta %@ incluída no app está faltando. O app pode estar danificado — tente reinstalá-lo." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Встроенный инструмент %@ отсутствует. Возможно, программа повреждена — переустановите её." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Det medföljande verktyget %@ saknas. Appen kan vara skadad — prova att installera om den." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Бракує вбудованого інструмента %@. Можливо, програму пошкоджено — спробуйте встановити її заново." }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "找不到随附的 %@ 工具。App 可能已损坏，请尝试重新安装。" }
        }
      }
    },
    "The crop already sets the size — every image comes out %@×%@. Switch the crop to a ratio, or clear it, to use a max size." : {
      "comment" : "Help text when a pixel crop makes the max size field irrelevant. Placeholders are the crop's width and height in pixels.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "The crop already sets the size — every image comes out %1$@×%2$@. Switch the crop to a ratio, or clear it, to use a max size." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "الاقتصاص يحدد الحجم بالفعل — فكل صورة تخرج بمقاس %1$@×%2$@. حوّل الاقتصاص إلى نسبة أو امسحه لاستخدام حد أقصى للحجم." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Ořez už velikost určuje — každý obrázek vyjde jako %1$@×%2$@. Chcete‑li použít maximální velikost, přepněte ořez na poměr stran, nebo ho smažte." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Der Zuschnitt legt die Größe bereits fest — jedes Bild kommt mit %1$@×%2$@ heraus. Stelle den Zuschnitt auf ein Verhältnis um oder entferne ihn, um eine Maximalgröße zu nutzen." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "El recorte ya fija el tamaño — todas las imágenes salen a %1$@×%2$@. Cambia el recorte a una proporción, o bórralo, para usar un tamaño máx." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "Le recadrage fixe déjà la taille — chaque image ressort en %1$@×%2$@. Passez le recadrage en ratio, ou effacez-le, pour utiliser une taille max." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "החיתוך כבר קובע את הגודל — כל תמונה יוצאת בגודל %1$@×%2$@. יש להחליף את החיתוך ליחס, או לנקות אותו, כדי להשתמש בגודל מרבי." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "Il ritaglio fissa già la dimensione — ogni immagine esce a %1$@×%2$@. Imposta il ritaglio su un rapporto, oppure cancellalo, per usare una dimensione max." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "切り取りですでにサイズが決まっているため、すべての画像が%1$@×%2$@になります。最大サイズを使うには、切り取りを比率に切り替えるか消去してください。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "자르기에서 이미 크기가 정해지므로, 모든 이미지가 %1$@×%2$@ 크기로 나옵니다. 최대 크기를 사용하려면 자르기를 비율로 바꾸거나 지우십시오." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "De uitsnede legt de grootte al vast — elke afbeelding komt er als %1$@×%2$@ uit. Zet de uitsnede om naar een verhouding of wis hem om een max. grootte te gebruiken." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Kadrowanie już ustala rozmiar — każdy obraz wyjdzie jako %1$@×%2$@. Przełącz kadrowanie na proporcje lub usuń je, aby korzystać z maksymalnego rozmiaru." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "O recorte já define o tamanho — toda imagem sai em %1$@×%2$@. Mude o recorte para proporção, ou limpe-o, para usar um tamanho máx." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Обрезка уже задаёт размер — каждое изображение выйдет %1$@×%2$@. Переключите обрезку на пропорции или очистите её, чтобы задать максимальный размер." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Beskärningen anger redan storleken — varje bild kommer ut som %1$@×%2$@. Ställ om beskärningen till ett förhållande, eller rensa den, för att använda en maxstorlek." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Обтинання вже задає розмір — кожне зображення вийде %1$@×%2$@. Щоб скористатися максимальним розміром, переведіть обтинання в пропорції або очистіть його." }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "裁剪已经决定了尺寸，每张图片都会输出为 %1$@×%2$@。若要使用最大尺寸，请将裁剪切换为比例，或清除裁剪。" }
        }
      }
    },

    "Rotation is always applied to the image itself, so photos stay upright in any app whichever option you choose." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotation is always applied to the image itself, so photos stay upright in any app whichever option you choose." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يُطبَّق الدوران على الصورة نفسها دائمًا، فتبقى الصور معتدلة في أي تطبيق أيًا كان الخيار الذي تختاره." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Otočení se vždy zapíše přímo do obrázku, takže fotky stojí rovně v každé aplikaci, ať zvolíte kteroukoli možnost." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Die Drehung wird immer auf das Bild selbst angewendet — Fotos stehen deshalb in jeder App aufrecht, welche Option du auch wählst." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "La rotación siempre se aplica a la propia imagen, así que las fotos se ven derechas en cualquier app, elijas la opción que elijas." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "La rotation est toujours appliquée à l’image elle-même : vos photos restent droites dans toutes les apps, quelle que soit l’option choisie." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הסיבוב מוחל תמיד על התמונה עצמה, ולכן תצלומים נשארים זקופים בכל יישום, ללא קשר לאפשרות הנבחרת." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "La rotazione viene sempre applicata all’immagine stessa, quindi le foto restano dritte in qualsiasi app, qualunque opzione tu scelga." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "回転は常に画像そのものに適用されるため、どれを選んでも写真はどのAppでも正しい向きで表示されます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "회전은 항상 이미지 자체에 적용되므로, 어떤 옵션을 선택하든 사진은 모든 앱에서 똑바로 표시됩니다." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "De rotatie wordt altijd op de afbeelding zelf toegepast, dus foto's staan in elke app rechtop, welke optie je ook kiest." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Obrót jest zawsze zapisywany w samym obrazie, więc zdjęcia stoją prosto w każdej aplikacji, niezależnie od wybranej opcji." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "A rotação é sempre aplicada à própria imagem, então as fotos ficam na posição certa em qualquer app, qualquer que seja a opção escolhida." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Поворот всегда применяется к самому изображению, поэтому фотографии стоят прямо в любой программе, какой бы вариант Вы ни выбрали." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotationen tillämpas alltid på själva bilden, så foton står upprätt i alla appar oavsett vilket alternativ du väljer." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Обертання завжди застосовується до самого зображення, тож фото стоять рівно в будь-якій програмі, хоч би який варіант ви вибрали." }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "旋转始终会应用到图片本身，因此无论你选哪一项，照片在任何 App 中都保持正立。" }
        }
      }
    },

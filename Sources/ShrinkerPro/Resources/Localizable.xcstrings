    "Rotation is always applied to the image itself, so photos stay upright in any app whichever option you choose." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotation is always applied to the image itself, so photos stay upright in any app whichever option you choose." }
        },
        "ar" : {
          "stringUnit" : { "state" : "translated", "value" : "يُطبَّق الدوران على الصورة نفسها دائمًا، فتبقى الصور معتدلة في أي تطبيق أيًا كان الخيار الذي تختاره." }
        },
        "ca" : {
          "stringUnit" : { "state" : "translated", "value" : "La rotació sempre s’aplica a la imatge mateixa, així que les fotos es veuen dretes a qualsevol app, triïs l’opció que triïs." }
        },
        "cs" : {
          "stringUnit" : { "state" : "translated", "value" : "Otočení se vždy zapíše přímo do obrázku, takže fotky stojí rovně v každé aplikaci, ať zvolíte kteroukoli možnost." }
        },
        "da" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotationen anvendes altid på selve billedet, så fotos vender rigtigt i enhver app, uanset hvilken indstilling du vælger." }
        },
        "de" : {
          "stringUnit" : { "state" : "translated", "value" : "Die Drehung wird immer auf das Bild selbst angewendet — Fotos stehen deshalb in jeder App aufrecht, welche Option du auch wählst." }
        },
        "el" : {
          "stringUnit" : { "state" : "translated", "value" : "Η περιστροφή εφαρμόζεται πάντα στην ίδια την εικόνα, οπότε οι φωτογραφίες παραμένουν όρθιες σε οποιαδήποτε εφαρμογή, όποια επιλογή κι αν κάνετε." }
        },
        "es" : {
          "stringUnit" : { "state" : "translated", "value" : "La rotación siempre se aplica a la propia imagen, así que las fotos se ven derechas en cualquier app, elijas la opción que elijas." }
        },
        "fa" : {
          "stringUnit" : { "state" : "translated", "value" : "چرخش همیشه روی خود تصویر اعمال می‌شود، بنابراین هر گزینه‌ای را که انتخاب کنید عکس‌ها در هر برنامه‌ای در جهت درست می‌مانند." }
        },
        "fi" : {
          "stringUnit" : { "state" : "translated", "value" : "Kierto kirjoitetaan aina itse kuvaan, joten valokuvat pysyvät oikein päin missä tahansa apissa, minkä vaihtoehdon valitsetkin." }
        },
        "fr" : {
          "stringUnit" : { "state" : "translated", "value" : "La rotation est toujours appliquée à l’image elle-même : vos photos restent droites dans toutes les apps, quelle que soit l’option choisie." }
        },
        "he" : {
          "stringUnit" : { "state" : "translated", "value" : "הסיבוב מוחל תמיד על התמונה עצמה, ולכן תצלומים נשארים זקופים בכל יישום, ללא קשר לאפשרות הנבחרת." }
        },
        "hr" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotacija se uvijek primjenjuje na samu sliku, pa fotografije stoje uspravno u svakoj aplikaciji, koju god opciju odabrali." }
        },
        "hu" : {
          "stringUnit" : { "state" : "translated", "value" : "Az elforgatás mindig magára a képre kerül, így a fényképek bármelyik appban állva maradnak, bármelyik lehetőséget választja." }
        },
        "is" : {
          "stringUnit" : { "state" : "translated", "value" : "Snúningi er alltaf beitt á myndina sjálfa, svo að ljósmyndir standa uppréttar í hvaða forriti sem er, sama hvaða valkost þú velur." }
        },
        "it" : {
          "stringUnit" : { "state" : "translated", "value" : "La rotazione viene sempre applicata all’immagine stessa, quindi le foto restano dritte in qualsiasi app, qualunque opzione tu scelga." }
        },
        "ja" : {
          "stringUnit" : { "state" : "translated", "value" : "回転は常に画像そのものに適用されるため、どれを選んでも写真はどのAppでも正しい向きで表示されます。" }
        },
        "ko" : {
          "stringUnit" : { "state" : "translated", "value" : "회전은 항상 이미지 자체에 적용되므로, 어떤 옵션을 선택하든 사진은 모든 앱에서 똑바로 표시됩니다." }
        },
        "nb" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotasjonen brukes alltid på selve bildet, så foto står riktig vei i alle apper uansett hvilket alternativ du velger." }
        },
        "nl" : {
          "stringUnit" : { "state" : "translated", "value" : "De rotatie wordt altijd op de afbeelding zelf toegepast, dus foto's staan in elke app rechtop, welke optie je ook kiest." }
        },
        "nn" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotasjonen blir alltid lagd på sjølve biletet, så foto står rett veg i alle appar uansett kva alternativ du vel." }
        },
        "pl" : {
          "stringUnit" : { "state" : "translated", "value" : "Obrót jest zawsze zapisywany w samym obrazie, więc zdjęcia stoją prosto w każdej aplikacji, niezależnie od wybranej opcji." }
        },
        "pt-BR" : {
          "stringUnit" : { "state" : "translated", "value" : "A rotação é sempre aplicada à própria imagem, então as fotos ficam na posição certa em qualquer app, qualquer que seja a opção escolhida." }
        },
        "pt-PT" : {
          "stringUnit" : { "state" : "translated", "value" : "A rotação é sempre aplicada à própria imagem, pelo que as fotografias ficam direitas em qualquer aplicação, seja qual for a opção escolhida." }
        },
        "ro" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotirea este aplicată întotdeauna imaginii în sine, așa că fotografiile rămân drepte în orice aplicație, indiferent ce opțiune alegeți." }
        },
        "ru" : {
          "stringUnit" : { "state" : "translated", "value" : "Поворот всегда применяется к самому изображению, поэтому фотографии стоят прямо в любой программе, какой бы вариант Вы ни выбрали." }
        },
        "sk" : {
          "stringUnit" : { "state" : "translated", "value" : "Otočenie sa vždy aplikuje priamo na obrázok, takže fotky zostanú správne otočené v každej aplikácii bez ohľadu na to, ktorú možnosť vyberiete." }
        },
        "sl" : {
          "stringUnit" : { "state" : "translated", "value" : "Zasuk se vedno zapiše v samo sliko, zato fotografije v vsaki aplikaciji ostanejo pokončne, ne glede na izbrano možnost." }
        },
        "sv" : {
          "stringUnit" : { "state" : "translated", "value" : "Rotationen tillämpas alltid på själva bilden, så foton står upprätt i alla appar oavsett vilket alternativ du väljer." }
        },
        "th" : {
          "stringUnit" : { "state" : "translated", "value" : "การหมุนจะถูกนำไปใช้กับตัวรูปภาพเสมอ รูปถ่ายจึงตั้งตรงในทุกแอปไม่ว่าคุณจะเลือกตัวเลือกใด" }
        },
        "tr" : {
          "stringUnit" : { "state" : "translated", "value" : "Döndürme her zaman görüntünün kendisine uygulanır; bu yüzden hangi seçeneği seçerseniz seçin fotoğraflar her uygulamada dik durur." }
        },
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Обертання завжди застосовується до самого зображення, тож фото стоять рівно в будь-якій програмі, хоч би який варіант ви вибрали." }
        },
        "vi" : {
          "stringUnit" : { "state" : "translated", "value" : "Xoay luôn được áp dụng lên chính hình ảnh, nên ảnh vẫn đứng thẳng trong mọi ứng dụng dù bạn chọn tùy chọn nào." }
        },
        "zh-HK" : {
          "stringUnit" : { "state" : "translated", "value" : "旋轉一律會套用到影像本身，所以無論你選哪一項，相片在任何App中都保持正立。" }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "旋转始终会应用到图片本身，因此无论你选哪一项，照片在任何 App 中都保持正立。" }
        },
        "zh-Hant" : {
          "stringUnit" : { "state" : "translated", "value" : "旋轉一律會套用到影像本身，因此無論你選哪一項，照片在任何App中都保持正立。" }
        }
      }
